{
  "name": "thesis-editor",
  "version": "3.0.0",
  "description": "论文格式要求解析、LaTeX 编译和结构化写作工具",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env src/server.js",
    "build": "npm run sync && npm run check",
    "check": "node scripts/check.js",
    "smoke": "node scripts/smoke-test.js",
    "sync": "node scripts/sync-static.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test",
    "start:compiler": "node --env-file-if-exists=.env compiler/server.js"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "docx": "^9.15.1",
    "image-size": "^2.0.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "fflate": "^0.8.3"
  }
}
