PORT=8787
HOST=127.0.0.1
DATA_DIR=./data
PUBLIC_DIR=./public
SESSION_TTL_DAYS=7
MAX_JSON_BYTES=20971520
MAX_ASSET_BYTES=5242880
CORS_ORIGIN=*
STORAGE_PREFIX=thesis-editor-v1

# 可配置的 Chat Completions 兼容服务。三个值均设置后启用格式解析。
# AI_BASE_URL 例如 https://your-provider.example/v1（或完整 /chat/completions URL）
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_RESPONSE_FORMAT=json_object
AI_TIMEOUT_MS=45000

# 本机 / Docker 使用 XeLaTeX；Vercel 使用下面的独立编译服务。
LATEX_COMMAND=xelatex
LATEX_TIMEOUT_MS=45000
COMPILE_CONCURRENCY=2
LATEX_SERVICE_URL=
# 独立编译服务和主应用设置同一个随机令牌，至少 24 字符。
LATEX_SERVICE_TOKEN=

# 默认使用 TeX Live 中的开源字体。学校要求指定字体时安装授权字体并填写其名称。
LATEX_FONT_SONG=FandolSong-Regular.otf
LATEX_FONT_HEI=FandolHei-Regular.otf
LATEX_FONT_KAI=FandolKai-Regular.otf
LATEX_FONT_FANG=FandolFang-Regular.otf
LATEX_FONT_TIMES=texgyretermes-regular.otf
LATEX_FONT_ARIAL=texgyreheros-regular.otf

# Upstash 云端持久化（两组变量任选一组）。留空时本机使用 JSON 存储。
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
